# Copy to .env and replace all example credentials before starting the services.
# The broker binds to localhost by default. Use a public host and firewall rules
# before allowing a device outside this machine to connect.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883

# Temporary test-device account. Its ACL permits publishing to any topic so we
# can discover the topic layout. Use one credential per device in production.
MQTT_USERNAME=test-device
MQTT_PASSWORD=replace-with-a-long-random-password

# Internal capture subscriber account. Do not configure this on device hardware.
MQTT_CAPTURE_USERNAME=raw-capture
MQTT_CAPTURE_PASSWORD=replace-with-another-long-random-password

MQTT_BROKER_HOST=broker
MQTT_BROKER_PORT=1883
CAPTURE_FILE=/app/captures/messages.jsonl

# API. JWT_SECRET signs login sessions: use 32+ random characters, e.g.
#   openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters
# First admin account, created only when no admin exists yet. The password
# must be changed at first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-temporary-admin-password
WEB_ORIGIN=http://localhost:5173
# Host port for the Docker Postgres.
POSTGRES_HOST_PORT=5432

# Outgoing mail (optional). Leave SMTP_HOST empty to only show passwords in the app.
# Production: e.g. AWS SES  -> SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Shade Energy BMS <no-reply@example.com>
APP_URL=http://localhost:5173
