# Copy to .env and replace all example credentials before starting the services.
# The broker binds to localhost by default. Use a public host and firewall rules
# before allowing a device outside this machine to connect.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883

# Temporary test-device account. Its ACL permits publishing to any topic so we
# can discover the topic layout. Use one credential per device in production.
MQTT_USERNAME=test-device
MQTT_PASSWORD=replace-with-a-long-random-password

# Internal capture subscriber account. Do not configure this on device hardware.
MQTT_CAPTURE_USERNAME=raw-capture
MQTT_CAPTURE_PASSWORD=replace-with-another-long-random-password

MQTT_BROKER_HOST=broker
MQTT_BROKER_PORT=1883
CAPTURE_FILE=/app/captures/messages.jsonl
